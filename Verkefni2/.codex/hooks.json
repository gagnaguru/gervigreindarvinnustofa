{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/auto-pytest.py\"",
            "timeout": 35,
            "statusMessage": "Running pytest"
          }
        ]
      }
    ]
  }
}
